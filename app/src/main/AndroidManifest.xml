<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarvelChampionsCampaignCompanion"
        tools:targetApi="31">
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/title_activity_register"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".DataAdminActivity"
            android:exported="false"
            android:label="@string/title_activity_dbmanager"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".CampaignInstanceDetail"
            android:exported="false"
            android:label="@string/title_activity_campaign_instance_detail"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".NewCampaignCreation"
            android:exported="false"
            android:label="@string/title_activity_dbmanager"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".CampaignSelector"
            android:exported="false"
            android:label="@string/title_activity_dbmanager"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".ScenarioScreen"
            android:exported="false"
            android:label="@string/title_activity_register"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MarvelChampionsCampaignCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>